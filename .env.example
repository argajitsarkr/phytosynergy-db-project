# PhytoSynergyDB - secret environment variables
#
# Copy this file to `.env` in the SAME directory as docker-compose.yml, on the
# SERVER, and fill in real values. `.env` is gitignored and must NEVER be
# committed. Docker Compose reads it automatically for ${VAR} substitution.
#
#   cp .env.example .env
#   nano .env
#
# See SECRETS_ROTATION.md for how to generate these and how to rotate them.
#
# ---------------------------------------------------------------------------
# IMPORTANT - use ALPHANUMERIC values only (letters and digits).
#
#   1. Docker Compose interprets `$` inside .env values as a variable
#      reference, so a `$` in a value gets silently mangled.
#   2. POSTGRES_PASSWORD is embedded in DATABASE_URL, which is a URL. A
#      password containing @ : / ? # or % breaks URL parsing and Django will
#      fail to connect with a confusing error.
#
# The generator commands in SECRETS_ROTATION.md produce safe values.
# ---------------------------------------------------------------------------

# Postgres password. Must match the password actually set on the database role
# (changing this alone does NOT change an existing database's password - see
# SECRETS_ROTATION.md, which uses ALTER USER).
POSTGRES_PASSWORD=replace-me-alphanumeric

# Django secret key. Rotating this signs out every logged-in user and
# invalidates any outstanding password-reset links. That is expected.
DJANGO_SECRET_KEY=replace-me-alphanumeric
